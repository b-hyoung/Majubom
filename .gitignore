!esp32/docs/presentation/img/*.png
# 런타임 생성 — 빈 침대 캘리브레이션 베이스라인(환경별로 다름)
server/tof_baseline.json
# 런타임 생성 — mmWave 베이스라인(환경별로 다름)
server/mmw_baseline.json
# 서버 런타임 DB — 실행 중 갱신, 배포 환경마다 다름(커밋 X)
server/majubom.db
# mmWave 실측 테스트/캘리브 로그 (실행마다 재생성)
mmWave/*.log
# mmWave 침대 ROI 캘리브레이션 (방마다 다름, 런타임)
mmWave/bed_roi.json
# 개인 발표/데모 자료 — 커밋 안 함
발표자료/
# 단일센서 펌웨어 백업 템플릿 (TOF/src/main.ino 와 중복)
TOF/single_sensor/
# 런타임 생성 — feature 로깅 DB (스냅샷은 CSV로 export해서 커밋)
